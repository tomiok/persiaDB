# This file is not a key.
# The waitlist form stays closed until you replace it.
#
# On your machine (the private key stays there, never in this repository):
#   node scripts/waitlist/keygen.mjs
#
# That overwrites this file with the public key. Commit the result.
# Decrypt later with scripts/waitlist/decrypt.mjs. See scripts/waitlist/README.md.
