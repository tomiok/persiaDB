---
import AsciiFigure from './AsciiFigure.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const diagram = `
╔═ relaxation ═════════════════════════════════════════════════════╗ 
║    ┏━━━━━━━━━━━━━━━━┓                                            ║░
║    ┃ L0 exact       ┃   every term required                      ║░
║    ┗━━━━━━━━━━━━━━━━┛                                            ║░
║             ▼                                                    ║░
║    ┏━━━━━━━━━━━━━━━━┓                                            ║░
║    ┃ L1 synonyms    ┃   expand groups                            ║░
║    ┗━━━━━━━━━━━━━━━━┛                                            ║░
║             ▼                                                    ║░
║    ┏━━━━━━━━━━━━━━━━┓                                            ║░
║    ┃ L2 drop terms  ┃   100, 75, 50, 1                           ║░
║    ┗━━━━━━━━━━━━━━━━┛                                            ║░
║             ▼                                                    ║░
║    ┏━━━━━━━━━━━━━━━━┓                                            ║░
║    ┃ L3 prefix      ┃   capped expansions                        ║░
║    ┗━━━━━━━━━━━━━━━━┛                                            ║░
║             ▼                                                    ║░
║    ┏━━━━━━━━━━━━━━━━┓                                            ║░
║    ┃ L4 fuzzy       ┃   edit distance 1 or 2                     ║░
║    ┗━━━━━━━━━━━━━━━━┛                                            ║░
║             ▼                                                    ║░
║    ┏━━━━━━━━━━━━━━━━┓                                            ║░
║    ┃ L5 fallback    ┃   static rank, or none                     ║░
║    ┗━━━━━━━━━━━━━━━━┛                                            ║░
╚══════════════════════════════════════════════════════════════════╝░
 ░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░
`.slice(1, -1);
---

<AsciiFigure
    label="Zero-results relaxation cascade"
    diagram={diagram}
    accent={['L0 exact']}
    accentAlt={['L5 fallback']}
>
    The cascade in <a href="https://github.com/tomiok/persiaDB/blob/main/SPEC.md#76-zero-results-avoidance-default-on">SPEC §7.6</a>.
    Stop at the first level with enough hits. A stricter level ranks above a looser one.
    Filters stay as written unless <code>relax.filters</code> is <code>last_resort</code>.
    The full table is in the
    <a href={`${base}/guide/features/#zero-results-relaxation`}>feature reference</a>.
    What is implemented, and what is still the design, is
    <a href={`${base}/guide/typo-tolerant-search/`}>typo-tolerant search</a>.
</AsciiFigure>
