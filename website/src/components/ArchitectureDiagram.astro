---
import AsciiFigure from './AsciiFigure.astro';
import { layerDiagram } from '../layers.mjs';

interface Props {
    hero?: boolean;
}

const { hero = false } = Astro.props;
const layer = layerDiagram();
---

<AsciiFigure
    label="Crate layers"
    diagram={layer.diagram}
    hero={hero}
    accent={layer.accent}
    accentAlt={layer.accentAlt}
>
    Layers from <a href="https://github.com/tomiok/persiaDB/blob/main/SPEC.md#3-architecture-overview">SPEC §3</a>.
    {layer.caption}
    Arrows point down: each layer is used by the one above it.
</AsciiFigure>
