---
import AsciiFigure from './AsciiFigure.astro';
import { queryPathCaption } from '../layers.mjs';

const queryStatus = queryPathCaption();

const diagram = `
╔═ query ══════════════════════════════════════════════════════════╗ 
║               ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓               ║░
║               ┃ 1. analyze the text              ┃               ║░
║               ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛               ║░
║                                ▼                                 ║░
║               ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓               ║░
║               ┃ 2. each segment                  ┃               ║░
║               ┃ and the memtable                 ┃               ║░
║               ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛               ║░
║                                ▼                                 ║░
║               ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓               ║░
║               ┃ 3. merge the top hits            ┃               ║░
║               ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛               ║░
║                                ▼                                 ║░
║               ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓               ║░
║               ┃ 4. too few hits?                 ┃               ║░
║               ┃ no: return them                  ┃               ║░
║               ┃ yes: relax                       ┃               ║░
║               ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛               ║░
║                                ▼                                 ║░
║               ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓               ║░
║               ┃ 5. cascade, L0 to L5             ┃               ║░
║               ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛               ║░
╚══════════════════════════════════════════════════════════════════╝░
 ░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░
`.slice(1, -1);
---

<AsciiFigure
    label="Life of a query"
    diagram={diagram}
    accent={['5. cascade']}
    accentAlt={['4. too few', 'no: return', 'yes: relax']}
>
    Designed query path (<a href="https://github.com/tomiok/persiaDB/blob/main/SPEC.md#7-search">SPEC §7</a>).
        The text compiler in step 1 and the BM25F scorer are in the tree. Searching segments, merging hits, and the cascade are not.
        Step 4 is the branch into zero-results relaxation. Filters stay strict unless the caller opts in.
        The response names the level and what changed.
        The longer account is <a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/guide/typo-tolerant-search/`}>typo-tolerant search</a>.
        {queryStatus}
</AsciiFigure>
