---
import AsciiFigure from './AsciiFigure.astro';
import { queryPathCaption } from '../layers.mjs';

const queryStatus = queryPathCaption();

const diagram = `
╔═ query ══════════════════════════════════════════════════════════╗ 
║               ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓               ║░
║               ┃ 1. analyze the text              ┃               ║░
║               ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛               ║░
║                                ▼                                 ║░
║               ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓               ║░
║               ┃ 2. each segment                  ┃               ║░
║               ┃ and the memtable                 ┃               ║░
║               ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛               ║░
║                                ▼                                 ║░
║               ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓               ║░
║               ┃ 3. merge the top hits            ┃               ║░
║               ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛               ║░
║                                ▼                                 ║░
║               ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓               ║░
║               ┃ 4. too few hits?                 ┃               ║░
║               ┃ no: return them                  ┃               ║░
║               ┃ yes: relax                       ┃               ║░
║               ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛               ║░
║                                ▼                                 ║░
║               ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓               ║░
║               ┃ 5. cascade, L0 to L5             ┃               ║░
║               ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛               ║░
╚══════════════════════════════════════════════════════════════════╝░
 ░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░
`.slice(1, -1);
---

<AsciiFigure
    label="Life of a query"
    diagram={diagram}
    accent={['2. each segment', '3. merge the top']}
    accentAlt={['5. cascade', '4. too few']}
>
    Designed query path (<a href="https://github.com/tomiok/persiaDB/blob/main/SPEC.md#7-search">SPEC §7</a>).
        Filters stay strict unless the caller opts in.
        The response is specified to name the level and what changed.
        <a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/guide/faceted-search/`}>Faceted search</a>
        covers filters, facets, sort, cursors, deadlines, and explain.
        <a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/guide/typo-tolerant-search/`}>Typo-tolerant search</a>
        covers the cascade.
        {queryStatus}
</AsciiFigure>
