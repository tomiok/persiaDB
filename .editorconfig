root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,proto}]
indent_size = 2

[*.md]
# Two trailing spaces are a Markdown line break.
trim_trailing_whitespace = false

[*.go]
indent_style = tab

[*.snap]
# Accepted insta snapshots are byte-exact; an editor save must not change them.
trim_trailing_whitespace = false
insert_final_newline = unset

[{*.bin,*.zst,*.fst,*.persia,*.persia.blobs,**/tests/fixtures/**,**/fuzz/corpus/**,**/testdata/**}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
